#!/usr/bin/env python3
"""Графический установщик CameAV для РЕД ОС.

Запуск с рабочего стола: ./cameav-setup
Если нет PyQt5, сначала ставится пакет python3-qt5.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def ensure_pyqt() -> None:
    try:
        import PyQt5  # noqa: F401
        return
    except Exception:
        pass
    packages = ["python3-qt5", "python3-qt5-base"]
    command = ["dnf", "install", "-y", *packages]
    if os.geteuid() != 0:
        if not shutil.which("pkexec"):
            sys.stderr.write("Для окна установщика нужен пакет python3-qt5.\n")
            raise SystemExit(1)
        command.insert(0, "pkexec")
    sys.stderr.write("Ставлю пакеты интерфейса: %s\n" % " ".join(packages))
    subprocess.check_call(command)
    os.execv(sys.executable, [sys.executable, str(ROOT / "cameav-setup"), *sys.argv[1:]])


def main() -> int:
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("QT_QPA_PLATFORM"):
        sys.stderr.write("Запустите установщик в графическом сеансе РЕД ОС: ./cameav-setup\n")
        return 1
    os.chdir(ROOT)
    sys.path.insert(0, str(ROOT))
    ensure_pyqt()
    from installer.wizard import main as wizard_main

    return wizard_main()


if __name__ == "__main__":
    raise SystemExit(main())
