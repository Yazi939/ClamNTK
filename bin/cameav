#!/usr/bin/env python3
"""Запуск ClamNTK. Недостающие ClamAV и Qt ставятся из репозитория до открытия окна."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys


def package_root() -> str:
    here = os.path.dirname(os.path.realpath(__file__))
    local = os.path.abspath(os.path.join(here, ".."))
    local_main = os.path.join(local, "cameav", "__main__.py")
    system_main = "/usr/share/cameav/cameav/__main__.py"
    if os.path.basename(here) == "bin" and os.path.isfile(local_main):
        return local
    if os.path.isfile(system_main):
        return "/usr/share/cameav"
    if os.path.isfile(local_main):
        return local
    sys.stderr.write("Не найдены файлы ClamNTK. Запустите установщик.\n")
    raise SystemExit(1)


def missing_packages() -> list[str]:
    missing: list[str] = []
    if shutil.which("clamscan") is None:
        missing.append("clamav")
    try:
        import PyQt5  # noqa: F401
    except Exception:
        missing.extend(["python3-qt5", "python3-qt5-base"])
    return missing


def ensure_runtime() -> None:
    packages = missing_packages()
    if not packages:
        return
    command = ["dnf", "install", "-y", *packages]
    if os.geteuid() != 0:
        if not shutil.which("pkexec"):
            sys.stderr.write("Нужны пакеты: %s\n" % " ".join(packages))
            raise SystemExit(1)
        command.insert(0, "pkexec")
    sys.stderr.write("ClamNTK устанавливает недостающие пакеты: %s\n" % " ".join(packages))
    subprocess.check_call(command)
    os.execv(sys.executable, [sys.executable, *sys.argv])


if __name__ == "__main__":
    ensure_runtime()
    sys.path.insert(0, package_root())
    from cameav.__main__ import main

    raise SystemExit(main())
