#!/usr/bin/env python3
"""Запуск ClamNTK. Недостающие ClamAV и Qt ставятся до открытия окна."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys


def package_root() -> str:
    here = os.path.dirname(os.path.realpath(__file__))
    local = os.path.abspath(os.path.join(here, ".."))
    local_main = os.path.join(local, "cameav", "__main__.py")
    system_main = "/usr/share/cameav/cameav/__main__.py"
    if os.path.basename(here) == "bin" and os.path.isfile(local_main):
        return local
    if os.path.isfile(system_main):
        return "/usr/share/cameav"
    if os.path.isfile(local_main):
        return local
    sys.stderr.write("Не найдены файлы ClamNTK. Запустите установщик.\n")
    raise SystemExit(1)


def needs_runtime() -> bool:
    if shutil.which("clamscan") is None:
        return True
    try:
        import PyQt5  # noqa: F401
    except Exception:
        return True
    return False


def ensure_runtime() -> None:
    if not needs_runtime():
        return
    root = package_root()
    command = [
        sys.executable,
        "-c",
        "import sys; sys.path.insert(0, sys.argv[1]); from cameav.runtime import install_missing; install_missing()",
        root,
    ]
    if os.geteuid() != 0:
        if not shutil.which("pkexec"):
            sys.stderr.write("Нужны права администратора, чтобы поставить ClamAV.\n")
            raise SystemExit(1)
        command.insert(0, "pkexec")
    sys.stderr.write("ClamNTK ставит ClamAV и библиотеки интерфейса до открытия окна.\n")
    subprocess.check_call(command)
    os.execv(sys.executable, [sys.executable, *sys.argv])


if __name__ == "__main__":
    ensure_runtime()
    sys.path.insert(0, package_root())
    from cameav.__main__ import main

    raise SystemExit(main())
